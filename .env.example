# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# In Vercel, set NEXTAUTH_URL to your production URL, e.g.:
# NEXTAUTH_URL="https://freelanceflow-v2-five.vercel.app"

# Google OAuth (get from console.cloud.google.com → APIs & Services → Credentials)
# REQUIRED for Google Sign-in to work. Without these, Google button will error.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth (callback URL: https://yourdomain.com/api/auth/callback/github)
# REQUIRED for GitHub sign-in to work.
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# Hunter.io
HUNTER_API_KEY="your-hunter-api-key"

# OpenAI
OPENAI_API_KEY="your-openai-api-key"

# Resend
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="hello@icloseleads.com"

# Optional platform SMTP sender (for example, a verified Zoho mailbox).
# When complete, this takes priority over Resend for account and campaign email.
PLATFORM_SMTP_HOST="smtp.zoho.com"
PLATFORM_SMTP_PORT="465"
PLATFORM_SMTP_SECURE="true"
PLATFORM_SMTP_USER="hello@icloseleads.com"
PLATFORM_SMTP_PASS="your-app-password"
PLATFORM_SMTP_FROM_EMAIL="hello@icloseleads.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FreelanceFlow"

# Server-to-server Organic Growth OS feed. Generate with `openssl rand -base64 48`.
# This endpoint never accepts browser sessions and never returns demo local leads.
GROWTH_OS_SERVICE_TOKEN="replace-with-at-least-32-random-characters"
GROWTH_OS_SOURCE_USER_EMAIL="owner@example.com"

# Groq (free AI — get key at console.groq.com)
GROQ_API_KEY="your-groq-api-key"

# Lemon Squeezy billing (keep secrets in environment variables, never the database)
LEMONSQUEEZY_API_KEY="your-lemonsqueezy-api-key"
LEMONSQUEEZY_WEBHOOK_SECRET="your-webhook-signing-secret"
LEMONSQUEEZY_STORE_ID="your-numeric-store-id"
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID="your-variant-id"
LEMONSQUEEZY_PRO_ANNUAL_VARIANT_ID="your-variant-id"
LEMONSQUEEZY_AGENCY_MONTHLY_VARIANT_ID="your-variant-id"
LEMONSQUEEZY_AGENCY_ANNUAL_VARIANT_ID="your-variant-id"
LEMONSQUEEZY_TEST_MODE="true"

# Billing provider: keep "lemonsqueezy" until Paddle sandbox has passed end-to-end QA.
BILLING_PROVIDER="lemonsqueezy"

# Paddle billing (sandbox and live use separate credentials and price IDs)
PADDLE_ENVIRONMENT="sandbox"
PADDLE_API_KEY="pdl_sdbx_apikey_..."
PADDLE_CLIENT_TOKEN="test_..."
PADDLE_WEBHOOK_SECRET="pdl_ntfset_..."
PADDLE_PRO_MONTHLY_PRICE_ID="pri_..."
PADDLE_PRO_ANNUAL_PRICE_ID="pri_..."
PADDLE_AGENCY_MONTHLY_PRICE_ID="pri_..."
PADDLE_AGENCY_ANNUAL_PRICE_ID="pri_..."

# Twilio softphone (use a Main API key; keep the public rollout disabled during beta)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-master-account-auth-token"
TWILIO_API_KEY_SID="SK..."
TWILIO_API_KEY_SECRET="your-api-key-secret"
TWILIO_ENCRYPTION_KEY="generate-a-long-random-secret"
TWILIO_SOFTPHONE_ENABLED="false"
TWILIO_NUMBER_MARKUP_PERCENT="50"
TWILIO_NUMBER_MIN_MARGIN_CENTS="100"
