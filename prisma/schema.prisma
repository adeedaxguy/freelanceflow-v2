generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// PostgreSQL — string enum values stored as plain strings (no native enum).
// Valid values for role: "USER" | "ADMIN"
// Valid values for status on Lead: "NEW" | "CONTACTED" | "REPLIED" | "NEGOTIATION" | "FOLLOW_UP" | "WON" | "LOST"
// Valid values for status on Campaign: "DRAFT" | "RUNNING" | "COMPLETED"
// Valid values for status on SentEmail: "SENT" | "DELIVERED" | "OPENED" | "BOUNCED" | "FAILED"

model User {
  id                String   @id @default(cuid())
  name              String?
  email             String   @unique
  password          String?
  role              String   @default("USER")
  niche             String?
  bio               String?
  rate              Float?
  portfolio         String?
  avatarUrl         String?
  googleId          String?  @unique
  suspended         Boolean  @default(false)
  sessionVersion    Int      @default(0)
  plan              String   @default("free")
  expertise         String?
  referralSource    String?
  weeklyLeads       Int      @default(0)
  weeklyLeadReset   DateTime @default(now())
  portfolioLinks    String? // JSON array of { label, url }
  gmailRefreshToken String? // OAuth2 refresh token for Gmail send
  gmailEmail        String? // Gmail address connected via OAuth2
  bonusLeads        Int      @default(0)
  whatsapp          String?
  marketingConsent  Boolean  @default(false)
  bonusClaimed      String? // JSON array of claimed bonus types e.g. ["subscribe","share"]
  referralCode      String?  @unique
  referredBy        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leads                Lead[]
  sentEmails           SentEmail[]
  campaigns            Campaign[]
  templates            Template[]
  supportTickets       SupportTicket[]
  followUps            FollowUp[]
  leadApplications     LeadApplication[]
  billingSubscriptions BillingSubscription[]
  telephonyWorkspace   TelephonyWorkspace?
  telephonyPurchases   TelephonyPurchase[]
  voiceCalls           VoiceCall[]
  apiKeys              ApiKey[]

  @@index([email])
  @@index([role])
  @@index([plan])
}

model ApiKey {
  id            String    @id @default(cuid())
  userId        String
  name          String
  keyHash       String    @unique
  prefix        String
  scopes        String
  requestsToday Int       @default(0)
  requestDay    DateTime  @default(now())
  totalRequests Int       @default(0)
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
}

model BillingSubscription {
  id                     String    @id @default(cuid())
  userId                 String
  provider               String    @default("LEMONSQUEEZY")
  externalSubscriptionId String    @unique
  externalCustomerId     String?
  externalOrderId        String?
  plan                   String
  variantId              String
  status                 String
  testMode               Boolean   @default(false)
  renewsAt               DateTime?
  endsAt                 DateTime?
  trialEndsAt            DateTime?
  cardBrand              String?
  cardLastFour           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([externalCustomerId])
}

model Lead {
  id             String   @id @default(cuid())
  userId         String
  company        String
  domain         String
  email          String?
  phone          String?
  confidence     Int?
  qualityScore   Int?
  bestMatchScore Int?
  niche          String?
  title          String?
  description    String?
  sourceUrl      String?
  source         String?
  notes          String?
  isManual       Boolean  @default(false)
  status         String   @default("NEW")
  savedAt        DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentEmails SentEmail[]
  followUps  FollowUp[]
  voiceCalls VoiceCall[]

  @@index([userId])
  @@index([niche])
  @@index([status])
}

model SentEmail {
  id       String   @id @default(cuid())
  userId   String
  leadId   String?
  subject  String
  body     String
  sentAt   DateTime @default(now())
  status   String   @default("SENT")
  resendId String?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([leadId])
  @@index([sentAt])
}

model AdminMailboxMessage {
  id         String    @id @default(cuid())
  externalId String?   @unique
  messageId  String?
  direction  String
  fromEmail  String
  toEmail    String
  subject    String
  body       String
  status     String    @default("RECEIVED")
  readAt     DateTime?
  replyToId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([direction, createdAt])
  @@index([status])
  @@index([readAt])
}

model Campaign {
  id         String   @id @default(cuid())
  userId     String
  name       String
  niche      String?
  status     String   @default("DRAFT")
  emailCount Int      @default(0)
  templateId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Template {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  niche     String?
  subject   String
  body      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
}

model BlogPost {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  excerpt      String?
  content      String
  category     String   @default("General")
  published    Boolean  @default(false)
  coverImage   String?
  readTime     Int      @default(5)
  author       String?
  metaTitle    String?
  metaDesc     String?
  focusKeyword String?
  ogImage      String?
  canonical    String?
  noIndex      Boolean  @default(false)
  twitterCard  String?
  schema       String?
  tags         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([published])
  @@index([category])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}

model SecurityRateLimit {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String?
  email      String
  subject    String
  messages   String
  status     String   @default("open")
  priority   String   @default("normal")
  category   String?
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model BlogComment {
  id          String   @id @default(cuid())
  postSlug    String
  parentId    String?
  authorName  String
  authorEmail String
  content     String
  approved    Boolean  @default(false)
  ip          String?
  createdAt   DateTime @default(now())

  parent  BlogComment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies BlogComment[] @relation("Replies")

  @@index([postSlug])
  @@index([parentId])
  @@index([approved])
}

model BlogCommentRateLimit {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip])
  @@index([createdAt])
}

model FollowUp {
  id          String    @id @default(cuid())
  userId      String
  leadId      String
  step        Int       @default(1)
  subject     String
  body        String
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leadId])
  @@index([scheduledAt])
  @@index([status])
}

// Tracks which users have marked a lead URL as "applied".
// leadUrl is the canonical job URL (not the saved Lead row ID) so it works
// for leads shown in the live feed even before they are saved to the DB.
model LeadApplication {
  id        String   @id @default(cuid())
  userId    String
  leadUrl   String
  appliedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, leadUrl])
  @@index([leadUrl])
  @@index([userId])
}

model TelephonyWorkspace {
  id                          String    @id @default(cuid())
  userId                      String    @unique
  status                      String    @default("PENDING")
  twilioAccountSid            String?   @unique
  twilioAuthTokenEncrypted    String?
  twilioApiKeySid             String?
  twilioApiKeySecretEncrypted String?
  twimlAppSid                 String?
  phoneNumberSid              String?
  phoneNumber                 String?
  phoneCountry                String?
  monthlyPriceCents           Int?
  priceCurrency               String?
  consentAcceptedAt           DateTime?
  lastError                   String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  calls     VoiceCall[]
  purchases TelephonyPurchase[]

  @@index([status])
  @@index([phoneNumber])
}

model TelephonyPurchase {
  id                     String    @id @default(cuid())
  userId                 String
  workspaceId            String
  phoneNumberSid         String?   @unique
  phoneNumber            String
  country                String
  monthlyPriceCents      Int
  currency               String
  status                 String    @default("CHECKOUT_PENDING")
  variantId              String
  externalSubscriptionId String?   @unique
  externalCustomerId     String?
  externalOrderId        String?
  subscriptionStatus     String?
  testMode               Boolean   @default(false)
  consentAcceptedAt      DateTime
  expiresAt              DateTime
  renewsAt               DateTime?
  endsAt                 DateTime?
  attempts               Int       @default(0)
  lastError               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace TelephonyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([workspaceId])
}

model VoiceCall {
  id              String    @id @default(cuid())
  workspaceId     String
  userId          String
  leadId          String?
  twilioCallSid   String?   @unique
  direction       String    @default("OUTBOUND")
  from            String
  to              String
  status          String    @default("QUEUED")
  durationSeconds Int?
  costCents       Int?
  costCurrency    String?
  outcome         String?
  notes           String?
  createdAt       DateTime  @default(now())
  answeredAt      DateTime?
  endedAt         DateTime?
  updatedAt       DateTime  @updatedAt

  workspace TelephonyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead      Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId, createdAt])
  @@index([leadId])
  @@index([status])
}
